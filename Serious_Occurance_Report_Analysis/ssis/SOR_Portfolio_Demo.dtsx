        <SQLTask:SqlTaskData SQLTask:Connection="{C84B32A4-BEC8-4EBA-BE2F-7109A05A5396}" SQLTask:SqlStatementSource="DECLARE @bronze_status_count INT;&#10;DECLARE @silver_status_count INT;&#10;DECLARE @bronze_category_count INT;&#10;DECLARE @silver_category_count INT;&#10;&#10;SELECT @bronze_status_count = COUNT(*)&#10;FROM bronze.SO_status;&#10;&#10;SELECT @silver_status_count = COUNT(*)&#10;FROM silver.SO_status;&#10;&#10;SELECT @bronze_category_count = COUNT(*)&#10;FROM bronze.SO_category;&#10;&#10;SELECT @silver_category_count = COUNT(*)&#10;FROM silver.SO_category;&#10;&#10;&#10;IF @bronze_status_count = 0&#10;BEGIN&#10;    THROW 51000, 'Validation failed: bronze.SO_status has 0 rows.', 1;&#10;END;&#10;&#10;IF @silver_status_count = 0&#10;BEGIN&#10;    THROW 51001, 'Validation failed: silver.SO_status has 0 rows.', 1;&#10;END;&#10;&#10;IF @bronze_category_count = 0&#10;BEGIN&#10;    THROW 51002, 'Validation failed: bronze.SO_category has 0 rows.', 1;&#10;END;&#10;&#10;IF @silver_category_count = 0&#10;BEGIN&#10;    THROW 51003, 'Validation failed: silver.SO_category has 0 rows.', 1;&#10;END;&#10;&#10;&#10;IF @bronze_status_count &lt;&gt; @silver_status_count&#10;BEGIN&#10;    THROW 51004, 'Validation failed: bronze.SO_status and silver.SO_status row counts do not match.', 1;&#10;END;&#10;&#10;IF @bronze_category_count &lt;&gt; @silver_category_count&#10;BEGIN&#10;    THROW 51005, 'Validation failed: bronze.SO_category and silver.SO_category row counts do not match.', 1;&#10;END;" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
